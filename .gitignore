/ios/
*.keystore
*.p12
*.mobileprovision
*.jks
validation/
artifacts/
fixtures-private/
*.log
**/build/
**/.gradle/
**/.cxx/

# Scratch output, local tool config, security-scan results and local databases never belong in the repository
.tmp-*
.mcp.json
strix_runs/
*.sqlite
*.sqlite3
*.db

